# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgres://thermite:thermite@localhost:5433/thermite

# Pool sizes. Ingest runs on its own pool so an error storm backpressures the
# SDKs instead of stalling logins and the dashboard; background sweepers use a
# separate 2-connection pool. Total Postgres connections ≈ the two below + 2.
# DATABASE_MAX_CONNECTIONS=10
# DATABASE_INGEST_MAX_CONNECTIONS=10

# =============================================================================
# Application
# =============================================================================
# Public-facing URL of your application. Also serves as the OAuth issuer and
# resource identifier advertised to MCP clients (/.well-known/*), so in
# production this must be the public HTTPS URL.
BASE_URL=http://localhost:8080

# Set to false for local development (no HTTPS)
SECURE_COOKIES=false

# When running behind a reverse proxy, set to true so auth rate limiting
# trusts X-Forwarded-For / X-Real-IP / Forwarded headers.
TRUST_PROXY_HEADERS=false

# Enables the "Dev login (local only)" shortcut that signs in as a fixed local
# user without FerrisKey. Only works in debug builds AND when set to true — the
# whole feature is compiled out of `dx build --release`, so it can never run in
# production. Leave unset/false otherwise.
# DEV_LOGIN=true

# =============================================================================
# Session
# =============================================================================
# 64+ byte hex-encoded secret for signing session cookies
# Generate with: openssl rand -hex 64
SESSION_SECRET=

# =============================================================================
# Encryption (optional)
# =============================================================================
# 32-byte base64-encoded key for AES-256-GCM encryption
# Generate with the crypto crate's generate_key() + encode_key()
# ENCRYPTION_KEY=

# =============================================================================
# FerrisKey (Authentication)
# =============================================================================
# FerrisKey base API URL (e.g. http://localhost:3333 or https://ferriskey.example.com/api)
FERRISKEY_URL=http://localhost:3333
# Optional: FerrisKey public OIDC issuer base URL. Falls back to FERRISKEY_URL
# (with a trailing /api stripped) if unset.
# FERRISKEY_ISSUER_URL=
FERRISKEY_REALM=myapp
FERRISKEY_CLIENT_ID=myapp-dashboard
FERRISKEY_CLIENT_SECRET=

# =============================================================================
# Registration allowlist
# =============================================================================
# Every account is a full operator over all projects and error data, so signup
# is not open to the internet. Restrict who may self-register with either or
# both of the lists below (comma-separated, matched case-insensitively). When
# BOTH are empty, only the first account may register on a fresh instance and
# registration closes once any user exists — so leaving these unset is safe.
# THERMITE_ALLOWED_EMAILS=alice@example.com,bob@example.com
# THERMITE_ALLOWED_EMAIL_DOMAINS=example.com

# =============================================================================
# SMTP (Email)
# =============================================================================
# For local dev, use the mailpit from compose.yaml (web UI on localhost:8028)
SMTP_HOST=localhost
SMTP_PORT=1028
SMTP_FROM=noreply@example.com
SMTP_USER=
SMTP_PASSWORD=
# tls (implicit TLS, port 465), starttls (port 587), or none (local relays only).
# Unset: none for localhost/mailpit, tls otherwise.
#SMTP_SECURITY=tls

# =============================================================================
# Self-reporting (optional) — thermite watches itself with its own SDK.
#
# Point this at a DIFFERENT thermite, or at least a different project: an instance reporting its
# own ingest failures into the ingest that is failing loses exactly the events worth having.
#
# THERMITE_RELEASE should be the deployed git SHA. Triage hands an agent the release an error came
# from, and `git diff <last good>..<bad>` only works when that name is a revision. Defaults to
# `thermite@<version>`, which never changes and tells an agent nothing.
# SENTRY_DSN is the former name and still works.
# =============================================================================
# THERMITE_DSN=
# THERMITE_RELEASE=
# ENVIRONMENT=development

# =============================================================================
# Ingest tuning
# =============================================================================
# Hard cap on a single ingest request body, before decompression.
# THERMITE_MAX_ENVELOPE_BYTES=20971520

# Per-project ingest quota, events per rolling minute. 0 disables it.
# THERMITE_RATE_LIMIT_PER_MINUTE=3000

# Extra payload keys to scrub at ingest, on top of the built-in denylist (password, passwd,
# secret, token, api_key, authorization, cookie, session, credentials, private_key).
# Comma-separated; matching is case-insensitive, ignores -/_, and fires on substrings.
# Scrubbing happens before the event is stored, so these values are never written.
# THERMITE_SCRUB_FIELDS=ssn,card_number

# =============================================================================
# Retention
# =============================================================================
# Events are dropped by whichever rule bites first. Both default to a bounded
# amount of history; 0 disables that rule.
#
# The rollup, the issue rows and any agent analyses survive eviction, so counts
# and charts stay true after the individual payloads are gone.
#
# Age alone does not bound disk — a traffic spike fills it inside the window —
# which is why the per-project cap is the rule that actually protects you.
# THERMITE_RETENTION_DAYS=90
# THERMITE_MAX_EVENTS_PER_PROJECT=100000

# Rows per delete statement. Deletes are batched so a sweep cannot hold locks
# long enough to stall ingest. Clamped to 100..50000.
# THERMITE_RETENTION_BATCH=5000

# =============================================================================
# Alerting
# =============================================================================
# Each new issue and each regression is delivered once to every channel
# configured here. Email goes through the SMTP settings above; the webhook is
# POSTed one JSON object per alert. With neither set, alerting is off.
#
# Delivery is at-least-once: a row is marked delivered only after every
# configured channel succeeded, so an unreachable receiver means a retry
# (possible duplicate), never a lost alert.
# Instance-wide defaults; a project can override both with its own routing
# (PUT /api/v1/projects/{slug}/alerts, or the project card in the dashboard).
# THERMITE_ALERT_EMAIL=you@example.com,oncall@example.com
# THERMITE_ALERT_WEBHOOK=https://example.com/hooks/thermite
